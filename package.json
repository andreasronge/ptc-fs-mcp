{
  "name": "ptc-fs-mcp",
  "version": "0.3.0",
  "description": "A small filesystem MCP server: read and write files under one confined root, over stdio.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "filesystem",
    "stdio",
    "ptc-runner"
  ],
  "homepage": "https://github.com/andreasronge/ptc-fs-mcp#readme",
  "bugs": "https://github.com/andreasronge/ptc-fs-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasronge/ptc-fs-mcp.git"
  },
  "license": "MIT",
  "author": "Andreas Ronge",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "type": "module",
  "bin": {
    "ptc-fs-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --build --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test --test-reporter=spec test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm test",
    "prepublishOnly": "pnpm run clean && pnpm run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
