#!/bin/sh
set -eu

expected=$(node -p "require('./package.json').packageManager.split('+')[0].split('@')[1]")
actual=$(pnpm --version)
[ "$expected" = "$actual" ] || {
  echo "bootstrap: pnpm $actual is on PATH but this repository pins $expected" >&2
  exit 1
}

pnpm install --frozen-lockfile
pnpm run build
